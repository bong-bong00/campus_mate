<!--
  Design Tokens — Campus Signal
  핸드오프 문서 "Design Tokens" 절의 확정값을 그대로 옮긴 것.
  새 색을 쓰고 싶으면 화면이 아니라 여기에 먼저 추가한다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── 배경 / 면 ────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Ink"               Color="#12150F"/>
  <SolidColorBrush x:Key="InkAlt"            Color="#1D2019"/>
  <SolidColorBrush x:Key="Surface"           Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceRaised"     Color="#FCFCFA"/>
  <SolidColorBrush x:Key="SurfaceSunken"     Color="#F7F7F3"/>
  <SolidColorBrush x:Key="SurfaceSide"       Color="#F8F8F5"/>
  <SolidColorBrush x:Key="SurfaceTableHead"  Color="#FAFAF7"/>
  <SolidColorBrush x:Key="AccentBg"          Color="#EEF7E2"/>
  <SolidColorBrush x:Key="AccentBgSoft"      Color="#F7FCF1"/>
  <SolidColorBrush x:Key="HoverRow"          Color="#F6FAF1"/>
  <SolidColorBrush x:Key="HoverSide"         Color="#EFEFE9"/>
  <SolidColorBrush x:Key="RowUnread"         Color="#FCFCF8"/>
  <SolidColorBrush x:Key="ExamWeekCell"      Color="#F8F8F3"/>

  <!-- ── 선 ──────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Border"            Color="#E2E2DB"/>
  <SolidColorBrush x:Key="BorderRow"         Color="#EFEFE9"/>
  <SolidColorBrush x:Key="BorderGrid"        Color="#F0F0EA"/>
  <SolidColorBrush x:Key="BorderInput"       Color="#DDDDD5"/>
  <SolidColorBrush x:Key="BorderDashed"      Color="#C6C7BE"/>
  <SolidColorBrush x:Key="BorderAccent"      Color="#C9E3A6"/>
  <SolidColorBrush x:Key="BorderAccentSoft"  Color="#B4CE94"/>
  <SolidColorBrush x:Key="BorderWarn"        Color="#E3C9BE"/>
  <SolidColorBrush x:Key="BorderCaution"     Color="#E8DBB8"/>
  <SolidColorBrush x:Key="BorderOnDark"      Color="#3A3F34"/>
  <SolidColorBrush x:Key="BorderPdfChip"     Color="#DCDCD3"/>

  <!-- ── 텍스트 ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="TextPrimary"       Color="#12140F"/>
  <SolidColorBrush x:Key="TextStrongAlt"     Color="#2A2F26"/>
  <SolidColorBrush x:Key="TextStrongAlt2"    Color="#20261C"/>
  <SolidColorBrush x:Key="TextBody"          Color="#3B4235"/>
  <SolidColorBrush x:Key="TextBody2"         Color="#4A5044"/>
  <SolidColorBrush x:Key="TextMuted"         Color="#6E7466"/>
  <SolidColorBrush x:Key="TextMuted2"        Color="#5F6659"/>
  <SolidColorBrush x:Key="TextMonoLabel"     Color="#6B7163"/>
  <SolidColorBrush x:Key="TextOnDark"        Color="#F2F1EA"/>
  <SolidColorBrush x:Key="TextOnDark2"       Color="#EFEFE7"/>
  <SolidColorBrush x:Key="TextOnDarkMuted"   Color="#9AA093"/>
  <SolidColorBrush x:Key="TextOnDarkMuted2"  Color="#A3A99A"/>
  <SolidColorBrush x:Key="TextOnAccent"      Color="#4A5544"/>
  <SolidColorBrush x:Key="TextOnAccentMono"  Color="#5E6B55"/>
  <SolidColorBrush x:Key="TextOnAccentBtn"   Color="#33422C"/>
  <SolidColorBrush x:Key="TextWarnBody"      Color="#6B584F"/>
  <SolidColorBrush x:Key="TextDisabledNum"   Color="#C6C7BE"/>

  <!-- ── 판정 / 상태 ─────────────────────────────────────────── -->
  <!-- 지원 가능 -->
  <SolidColorBrush x:Key="EligibleBg"        Color="#E4F1DA"/>
  <SolidColorBrush x:Key="EligibleFg"        Color="#1F5E44"/>
  <SolidColorBrush x:Key="EligibleDot"       Color="#2F8F5E"/>
  <SolidColorBrush x:Key="EligibleSolidBg"   Color="#1F5E44"/>
  <SolidColorBrush x:Key="EligibleSolidFg"   Color="#EFFAE6"/>
  <SolidColorBrush x:Key="EligibleHeroBg"    Color="#EEF7E2"/>
  <SolidColorBrush x:Key="EligibleHeroBd"    Color="#C9E3A6"/>
  <!-- 확인 필요 -->
  <SolidColorBrush x:Key="CheckBg"           Color="#F7EED4"/>
  <SolidColorBrush x:Key="CheckFg"           Color="#7E651C"/>
  <SolidColorBrush x:Key="CheckDot"          Color="#C9A227"/>
  <SolidColorBrush x:Key="CheckSolidBg"      Color="#7E651C"/>
  <SolidColorBrush x:Key="CheckSolidFg"      Color="#FBF5E6"/>
  <SolidColorBrush x:Key="CheckHeroBg"       Color="#FCF8EC"/>
  <SolidColorBrush x:Key="CheckHeroBd"       Color="#E8DBB8"/>
  <!-- 자격 미달 / 경고 -->
  <SolidColorBrush x:Key="FailBg"            Color="#F0E3DE"/>
  <SolidColorBrush x:Key="FailFg"            Color="#9C482B"/>
  <SolidColorBrush x:Key="FailDot"           Color="#B7BFC8"/>
  <SolidColorBrush x:Key="FailSolidBg"       Color="#9C482B"/>
  <SolidColorBrush x:Key="FailSolidFg"       Color="#FCEFE9"/>
  <SolidColorBrush x:Key="FailHeroBg"        Color="#FBF2EE"/>
  <SolidColorBrush x:Key="FailHeroBd"        Color="#E3C9BE"/>
  <SolidColorBrush x:Key="WarnSurface"       Color="#FCF4F0"/>
  <!-- 중립 -->
  <SolidColorBrush x:Key="NeutralBg"         Color="#EDEDE6"/>
  <SolidColorBrush x:Key="NeutralFg"         Color="#5F6659"/>
  <!-- 착수 시점 -->
  <SolidColorBrush x:Key="StartTone"         Color="#3F6B8A"/>
  <!-- 마감 임박 D-day -->
  <SolidColorBrush x:Key="UrgentTone"        Color="#9C482B"/>
  <SolidColorBrush x:Key="CalmTone"          Color="#4A5044"/>

  <!-- ── 액센트 (라임) — 밝은 배경 위 텍스트로는 절대 쓰지 말 것 ── -->
  <SolidColorBrush x:Key="Lime"              Color="#B9F27C"/>

  <!-- ── 셸 / 크롬 ───────────────────────────────────────────── -->
  <SolidColorBrush x:Key="ChromeGlyph"       Color="#6E7367"/>
  <SolidColorBrush x:Key="ChromeHover"       Color="#252A20"/>
  <SolidColorBrush x:Key="ChromeClose"       Color="#C0392B"/>
  <SolidColorBrush x:Key="BrandMark"         Color="#8C9184"/>
  <SolidColorBrush x:Key="NavIdleFg"         Color="#CFD4C6"/>

  <!-- ── 토스트 ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="ToastBg"           Color="#1D2019"/>
  <SolidColorBrush x:Key="ToastBd"           Color="#383D31"/>
  <SolidColorBrush x:Key="ToastFg"           Color="#F1F1E9"/>
  <SolidColorBrush x:Key="ToastBtnBd"        Color="#454B3C"/>

  <!-- ── 캘린더 이벤트 칩 ────────────────────────────────────── -->
  <SolidColorBrush x:Key="EvtDeadlineBg"     Color="#F0E3DE"/>
  <SolidColorBrush x:Key="EvtDeadlineFg"     Color="#9C482B"/>
  <SolidColorBrush x:Key="EvtExamBg"         Color="#12150F"/>
  <SolidColorBrush x:Key="EvtExamFg"         Color="#EFEFE7"/>
  <SolidColorBrush x:Key="EvtAcademicBg"     Color="#E4F1DA"/>
  <SolidColorBrush x:Key="EvtAcademicFg"     Color="#1F5E44"/>
  <SolidColorBrush x:Key="EvtPersonalBg"     Color="#EDEDE6"/>
  <SolidColorBrush x:Key="EvtPersonalFg"     Color="#4A5044"/>

  <!-- ── 공통 수치 ───────────────────────────────────────────── -->
  <CornerRadius x:Key="R2" TopLeft="2" TopRight="2" BottomLeft="2" BottomRight="2"/>
  <CornerRadius x:Key="R3" TopLeft="3" TopRight="3" BottomLeft="3" BottomRight="3"/>
  <CornerRadius x:Key="R6" TopLeft="6" TopRight="6" BottomLeft="6" BottomRight="6"/>

</ResourceDictionary>
