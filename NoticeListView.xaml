<UserControl x:Class="CampusSignal.Views.NoticeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             Background="{StaticResource Surface}">

  <!-- 사이드바가 바닥까지 닿도록 스크롤 뷰포트 높이를 최소 높이로 잡는다. -->
  <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── 좌측 필터 사이드바 ────────────────────────────────────────── -->
    <Border Grid.Column="0" Background="{StaticResource SurfaceSide}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,18">

        <TextBlock Style="{StaticResource MonoLabel}" Margin="16,0,16,10"
                   inf:Tracking.Em="0.13" inf:Tracking.Text="판정"/>

        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SideRowButton}" Command="{Binding Command}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="1" RadiusY="1"
                             VerticalAlignment="Center" Fill="{Binding Dot}"/>
                  <TextBlock Grid.Column="1" FontSize="13"
                             Margin="9,0" VerticalAlignment="Center"
                             FontWeight="{Binding Weight}"
                             Text="{Binding Label}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                        <Setter Property="Foreground" Value="{StaticResource TextBody2}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMonoLabel}" Text="{Binding Count}"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource MonoLabel}" Margin="16,18,16,10"
                   inf:Tracking.Em="0.13" inf:Tracking.Text="출처"/>

        <ItemsControl ItemsSource="{Binding Sources}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SideRowButton}" Padding="16,7"
                      Command="{Binding Command}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="12.5" Text="{Binding Label}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                        <Setter Property="Foreground" Value="{StaticResource TextBody2}"/>
                        <Style.Triggers>
                          <!-- 출처는 다중 선택. 꺼진 출처는 흐리게 표시한다. -->
                          <DataTrigger Binding="{Binding IsSelected}" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="11"
                             Foreground="{StaticResource TextMonoLabel}" Text="{Binding Count}"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource DashedButton}" Margin="16,18,16,0" Padding="12"
                Command="{Binding RegisterNoticeCommand}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" TextAlignment="Center"
                       Foreground="{StaticResource TextBody2}" Text="＋ 공고 직접 등록"/>
            <TextBlock Style="{StaticResource Text}" FontSize="11" Margin="0,4,0,0"
                       TextAlignment="Center"
                       Foreground="{StaticResource TextMonoLabel}" Text="URL · PDF · 캡처"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- ── 우측 테이블 ───────────────────────────────────────────────── -->
    <StackPanel Grid.Column="1">

      <Border Background="{StaticResource SurfaceTableHead}" Padding="22,12"
              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="92"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource MonoLabel}"
                     inf:Tracking.Em="0.08" inf:Tracking.Text="D-DAY"/>
          <TextBlock Grid.Column="1" Style="{StaticResource MonoLabel}"
                     inf:Tracking.Em="0.08" inf:Tracking.Text="공고"/>
          <TextBlock Grid.Column="2" Style="{StaticResource MonoLabel}"
                     inf:Tracking.Em="0.08" inf:Tracking.Text="판정"/>
          <TextBlock Grid.Column="3" Style="{StaticResource MonoLabel}"
                     inf:Tracking.Em="0.08" inf:Tracking.Text="출처"/>
          <TextBlock Grid.Column="4" Style="{StaticResource MonoLabel}"
                     inf:Tracking.Em="0.08" inf:Tracking.Text="요건"/>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource RowButton}" Command="{Binding Command}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="78"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="13.5"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{Binding DDayBrush}" Text="{Binding DDay}"/>

                <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Text}" FontSize="12" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource TextMuted2}" Text="{Binding Note}"/>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Badge}"
                        Background="{Binding BadgeBackground}">
                  <TextBlock Style="{StaticResource BadgeText}"
                             Foreground="{Binding BadgeForeground}" Text="{Binding JudgmentText}"/>
                </Border>

                <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted2}" Text="{Binding SourceShort}"/>

                <TextBlock Grid.Column="4" Style="{StaticResource Mono}" FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBody2}" Text="{Binding RequirementRatio}"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 빈 상태 -->
      <Border Padding="22,40" Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"
                     TextAlignment="Center" Text="조건에 맞는 공고가 없습니다"/>
          <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,6,0,0"
                     TextAlignment="Center"
                     Foreground="{StaticResource TextMuted}" Text="판정이나 출처 필터를 넓혀 보세요"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
