<UserControl x:Class="CampusSignal.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             Background="{StaticResource Surface}">

  <UserControl.Resources>
    <!-- 히어로는 헤더에 맞닿아야 하므로 위쪽 테두리가 없다. -->
    <Style x:Key="HeroButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{Binding HeroBackground}"
                    BorderBrush="{Binding HeroBorder}"
                    BorderThickness="1,0,1,1"
                    Padding="24,22">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel Margin="26,0,26,34">

    <!-- ── 히어로 배너 — 항상 가장 급한 단 한 건 ─────────────────────── -->
    <Button Style="{StaticResource HeroButton}" Command="{Binding HeroCommand}"
            Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Mono}" FontSize="40" FontWeight="SemiBold"
                     LineHeight="40" LineStackingStrategy="BlockLineHeight"
                     Foreground="{StaticResource EligibleFg}" Text="{Binding HeroDDay}"/>
          <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Margin="0,5,0,0"
                     Foreground="{StaticResource TextOnAccentMono}" Text="{Binding HeroDeadline}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource Badge}" Padding="9,3"
                    Background="{Binding HeroBadgeBackground}">
              <TextBlock Style="{StaticResource Text}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{Binding HeroBadgeForeground}" Text="{Binding HeroJudgmentText}"/>
            </Border>
            <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextOnAccentMono}" Text="{Binding HeroSource}"/>
          </StackPanel>

          <TextBlock Style="{StaticResource Text}" FontSize="22" FontWeight="Bold"
                     Margin="0,11,0,0" TextWrapping="Wrap" Text="{Binding HeroTitle}"/>

          <TextBlock Style="{StaticResource Text}" FontSize="13.5" Margin="0,8,0,0"
                     LineHeight="21.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextOnAccent}" Text="{Binding HeroDescription}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button Style="{StaticResource PrimaryButton}" Content="{Binding HeroPrimaryText}"
                  Command="{Binding HeroCommand}"/>
          <Button Style="{StaticResource OutlineButton}" Content="{Binding HeroSecondaryText}"
                  Command="{Binding HeroSecondaryCommand}"
                  Margin="0,8,0,0" Padding="12,11"
                  BorderBrush="{StaticResource BorderAccentSoft}"
                  Foreground="{StaticResource TextOnAccentBtn}"/>
        </StackPanel>
      </Grid>
    </Button>

    <!-- ── 2열 본문 ──────────────────────────────────────────────────── -->
    <Grid Margin="0,26,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>

      <!-- 좌측 -->
      <StackPanel Grid.Column="0" Margin="0,0,26,0">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource SectionTitle}" Text="그다음 할 일"/>
          <TextBlock Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                     VerticalAlignment="Bottom" Text="{Binding TodoSubtitle}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Todos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButton}" Command="{Binding Command}"
                      Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="16"
                             FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{Binding UrgencyBrush}" Text="{Binding Urgency}"/>

                  <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Text}" FontSize="14.5" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Text="{Binding Title}"/>
                      <Border Style="{StaticResource Badge}" Margin="9,0,0,0"
                              Background="{Binding BadgeBackground}">
                        <TextBlock Style="{StaticResource BadgeText}"
                                   Foreground="{Binding BadgeForeground}" Text="{Binding JudgmentText}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,5,0,0"
                               LineHeight="19.4" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}" Text="{Binding Note}"/>
                  </StackPanel>

                  <TextBlock Grid.Column="2" Style="{StaticResource Text}" FontSize="12"
                             FontWeight="Medium" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{StaticResource TextOnAccentBtn}">
                    <Run Text="{Binding ActionText, Mode=OneWay}"/><Run Text=" →"/>
                  </TextBlock>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
          <TextBlock Style="{StaticResource SectionTitle}" Text="시간표와 겹치지 않는 프로그램"/>
          <TextBlock Style="{StaticResource SectionNote}" Margin="12,0,0,0"
                     VerticalAlignment="Bottom" Text="{Binding ProgramSubtitle}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Programs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource CardButton}" Command="{Binding Command}"
                      Padding="14,13" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource MonoLabel}" Text="{Binding Tag}"/>
                  <TextBlock Style="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold"
                             Margin="0,8,0,0" LineHeight="18.9"
                             LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                             Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Text}" FontSize="11.5" Margin="0,7,0,0"
                             Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                             Text="{Binding Meta}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 우측 330px -->
      <StackPanel Grid.Column="1">

        <!-- 시험 충돌 -->
        <Border Style="{StaticResource DarkCard}"
                Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Style="{StaticResource Mono}" FontSize="10.5"
                       Foreground="{StaticResource Lime}"
                       inf:Tracking.Em="0.14" inf:Tracking.Text="EXAM CONFLICT"/>
            <TextBlock Style="{StaticResource Text}" FontSize="15.5" FontWeight="Bold"
                       Margin="0,10,0,0" LineHeight="23.3"
                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Foreground="{StaticResource TextOnDark2}" Text="{Binding ConflictTitle}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,9,0,0"
                       LineHeight="20.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Foreground="{StaticResource TextOnDarkMuted2}"
                       inf:Emphasis.Brush="{StaticResource TextOnDark2}"
                       inf:Emphasis.Markup="{Binding ConflictBody}"/>
          </StackPanel>
        </Border>

        <!-- 이번 주 캘린더 -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" SnapsToDevicePixels="True">
          <StackPanel>
            <Border Background="{StaticResource SurfaceSunken}" Padding="15,12"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
              <Grid>
                <TextBlock Style="{StaticResource Text}" FontSize="13" FontWeight="Bold"
                           Text="이번 주 캘린더" VerticalAlignment="Center"/>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                        Content="전체 보기 →" Command="{Binding GoCalendarCommand}"/>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Week}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderRow}" BorderThickness="0,0,0,1"
                          Padding="15,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource Mono}" FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMonoLabel}" Text="{Binding DayLabel}"/>
                      <TextBlock Grid.Column="1" Style="{StaticResource Text}" FontSize="12.5"
                                 Margin="12,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextStrongAlt}" Text="{Binding Title}"/>
                      <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center"
                               Fill="{Binding Dot}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 확인 필요 안내 -->
        <Button Style="{StaticResource CardButton}" Margin="0,16,0,0" Padding="15,14"
                Background="{StaticResource Surface}"
                Command="{Binding GoProfileCommand}"
                Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text}" FontSize="13" FontWeight="Bold"
                       Text="{Binding BlockedTitle}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,7,0,0"
                       LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}"
                       inf:Emphasis.Brush="{StaticResource TextPrimary}"
                       inf:Emphasis.Weight="SemiBold"
                       inf:Emphasis.Markup="{Binding BlockedBody}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"
                       Margin="0,11,0,0" Foreground="{StaticResource EligibleFg}"
                       Text="{Binding BlockedLink}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
