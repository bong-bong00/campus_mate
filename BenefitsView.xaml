<UserControl x:Class="CampusSignal.Views.BenefitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">

  <UserControl.Resources>
    <Style x:Key="BenefitTab" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="2" Background="Transparent"
                    BorderBrush="{StaticResource BorderInput}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ink}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnDark}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel Margin="26,20,26,34">

    <!-- 분류 탭 -->
    <ItemsControl ItemsSource="{Binding Tabs}" Margin="0,0,0,18">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource BenefitTab}" Content="{Binding Label}"
                  Command="{Binding Command}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 카드 그리드 -->
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="2" BorderThickness="1" Padding="17,16" Margin="0,0,10,10"
                  Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource MonoLabel}" VerticalAlignment="Center"
                           Text="{Binding Department}"/>
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right"
                        Background="{Binding StateBackground}">
                  <TextBlock Style="{StaticResource BadgeText}"
                             Foreground="{Binding StateForeground}" Text="{Binding StateText}"/>
                </Border>
              </Grid>

              <TextBlock Style="{StaticResource Text}" FontSize="15" FontWeight="Bold"
                         Margin="0,10,0,0" LineHeight="21"
                         LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                         Text="{Binding Title}"/>

              <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,8,0,0"
                         LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                         Foreground="{StaticResource TextMuted}" Text="{Binding Description}"/>

              <Border BorderBrush="#E7E7E0" BorderThickness="0,1,0,0" Margin="0,12,0,0"
                      Padding="0,11,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Mono}" FontSize="11.5"
                             Foreground="{StaticResource TextMuted2}" Text="{Binding TimeText}"/>
                  <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Margin="14,0,0,0"
                             Foreground="{StaticResource TextMuted2}" Text="{Binding CreditText}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 제외 목록 -->
    <TextBlock Style="{StaticResource SectionTitleSm}" Margin="0,22,0,10"
               Text="{Binding ExcludedTitle}"/>

    <ItemsControl ItemsSource="{Binding Excluded}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="2" BorderThickness="1" Padding="15,11" Margin="0,0,0,6"
                  Background="{StaticResource SurfaceTableHead}"
                  BorderBrush="{StaticResource BorderRow}">
            <Grid>
              <TextBlock Style="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"
                         Foreground="{StaticResource TextMuted2}" Text="{Binding Title}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="11.5" HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FailFg}" Text="{Binding ClashText}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
