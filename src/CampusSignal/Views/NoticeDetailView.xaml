<UserControl x:Class="CampusSignal.Views.NoticeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             Background="{StaticResource Surface}">

  <StackPanel Margin="26,20,26,34">

    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,0,0,14"
            FontSize="12.5" FontWeight="Normal"
            Foreground="{StaticResource TextMuted}"
            Content="{Binding BackText}" Command="{Binding BackCommand}"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <!-- ── 좌측 ───────────────────────────────────────────────────── -->
      <StackPanel Grid.Column="0" Margin="0,0,24,0">

        <!-- 요약 배너 -->
        <Border CornerRadius="2" BorderThickness="1" Padding="22,20"
                Background="{Binding HeroBackground}" BorderBrush="{Binding HeroBorder}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}" Padding="9,3"
                      Background="{Binding BadgeBackground}">
                <TextBlock Style="{StaticResource Text}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding BadgeForeground}" Text="{Binding JudgmentText}"/>
              </Border>
              <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextOnAccentMono}" Text="{Binding SourceText}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Text}" FontSize="24" FontWeight="Bold"
                       Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding NoticeTitle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <TextBlock Style="{StaticResource Mono}" FontSize="12.5"
                         Foreground="{StaticResource TextOnAccent}" Text="{Binding DeadlineText}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Margin="26,0,0,0"
                         Foreground="{StaticResource TextOnAccent}" Text="{Binding DDayText}"/>
              <TextBlock Style="{StaticResource Mono}" FontSize="12.5" Margin="26,0,0,0"
                         Foreground="{StaticResource TextOnAccent}" Text="{Binding AmountText}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 자격 요건 대조 — 근거 표기가 이 화면의 신뢰 장치다 -->
        <TextBlock Style="{StaticResource SectionTitleSm}" Margin="0,22,0,0" Text="자격 요건 대조"/>
        <TextBlock Style="{StaticResource SectionNote}" Margin="0,4,0,0"
                   Text="{Binding RequirementCaption}"/>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" SnapsToDevicePixels="True">
          <ItemsControl ItemsSource="{Binding Requirements}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderRow}" BorderThickness="0,0,0,1"
                        Padding="16,13">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource Text}" FontSize="14"
                               FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding MarkBrush}" Text="{Binding Mark}"/>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Text}" FontSize="13.5" FontWeight="Medium"
                                 TextWrapping="Wrap" Text="{Binding Label}"/>
                      <TextBlock Style="{StaticResource Text}" FontSize="11.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap"
                                 Foreground="{StaticResource TextMonoLabel}" Text="{Binding Evidence}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="12.5"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBody}" Text="{Binding MyValue}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 필요 서류 · 착수 역산 -->
        <TextBlock Style="{StaticResource SectionTitleSm}" Margin="0,22,0,12"
                   Text="필요 서류 · 착수 역산"/>

        <ItemsControl ItemsSource="{Binding Documents}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceRaised}"
                      Padding="15,12" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="92"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource Text}" FontSize="13.5"
                             FontWeight="Medium" VerticalAlignment="Center" Text="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Style="{StaticResource Text}" FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextMuted2}" Text="{Binding Issuer}"/>
                  <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextBody2}" Text="{Binding LeadText}"/>
                  <Border Grid.Column="3" Style="{StaticResource Badge}"
                          Background="{Binding StateBackground}">
                    <TextBlock Style="{StaticResource BadgeText}"
                               Foreground="{Binding StateForeground}" Text="{Binding StateText}"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 역산 결론 -->
        <Border Style="{StaticResource DarkCard}" Padding="16,14" Margin="0,2,0,0">
          <TextBlock Style="{StaticResource Text}" FontSize="13" LineHeight="20.8"
                     LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextOnDark2}"
                     inf:Emphasis.Brush="{StaticResource Lime}"
                     inf:Emphasis.Weight="SemiBold"
                     inf:Emphasis.Markup="{Binding LeadNote}"/>
        </Border>
      </StackPanel>

      <!-- ── 우측 420px ─────────────────────────────────────────────── -->
      <StackPanel Grid.Column="1">

        <!-- 경고 카드 -->
        <Border CornerRadius="2" BorderThickness="1" Padding="16,15"
                Background="{Binding SideBackground}" BorderBrush="{Binding SideBorder}"
                Visibility="{Binding HasSideNote, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Style="{StaticResource Mono}" FontSize="10.5"
                       Foreground="{Binding SideTone}"
                       inf:Tracking.Em="0.12" inf:Tracking.Text="{Binding SideLabel}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="14" FontWeight="Bold"
                       Margin="0,8,0,0" LineHeight="21"
                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Text="{Binding SideTitle}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,7,0,0"
                       LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Foreground="{StaticResource TextWarnBody}" Text="{Binding SideBody}"/>
          </StackPanel>
        </Border>

        <!-- 공고 원문 뷰어 -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" SnapsToDevicePixels="True">
          <StackPanel>
            <Border Background="{StaticResource SurfaceSunken}" Padding="14,11"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
              <Grid>
                <TextBlock Style="{StaticResource Text}" FontSize="12.5" FontWeight="Bold"
                           Text="공고 원문"/>
                <TextBlock Style="{StaticResource Mono}" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextMonoLabel}" Text="{Binding PdfFile}"/>
              </Grid>
            </Border>

            <!-- 사선 해치 자리표시자. 실제로는 PdfiumViewer 등을 얹고
                 추출 근거 문장에 하이라이트를 그린다. -->
            <Grid Height="250">
              <Rectangle>
                <Rectangle.Fill>
                  <DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
                    <DrawingBrush.Transform>
                      <RotateTransform Angle="45"/>
                    </DrawingBrush.Transform>
                    <DrawingBrush.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Brush="#F2F2ED">
                          <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,14,14"/>
                          </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#EAEAE3">
                          <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,7,14"/>
                          </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                      </DrawingGroup>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Border Background="{StaticResource SurfaceRaised}"
                      BorderBrush="{StaticResource BorderPdfChip}" BorderThickness="1"
                      Padding="11,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Mono}" FontSize="11.5"
                           Foreground="{StaticResource TextMuted2}" Text="{Binding PdfPlaceholder}"/>
              </Border>
            </Grid>

            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,11">
              <TextBlock Style="{StaticResource Text}" FontSize="12" LineHeight="19.2"
                         LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                         Foreground="{StaticResource TextMuted}" Text="{Binding PdfNote}"/>
            </Border>
          </StackPanel>
        </Border>

        <!-- 변경 이력 -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="15,14">
          <StackPanel>
            <TextBlock Style="{StaticResource CardTitle}" Text="변경 이력"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,8,0,0"
                       LineHeight="20.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" Text="{Binding ChangeHistory}"/>
          </StackPanel>
        </Border>

        <!-- 액션 -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                  Background="{Binding PrimaryBackground}" Foreground="{Binding PrimaryForeground}"
                  Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"/>
          <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                  BorderBrush="{StaticResource BorderDashed}"
                  Content="{Binding SecondaryText}" Command="{Binding SaveCommand}"/>
        </Grid>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
