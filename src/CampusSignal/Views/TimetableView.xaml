<UserControl x:Class="CampusSignal.Views.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">

  <Grid Margin="26,20,26,34">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- ── 주간 격자 ─────────────────────────────────────────────────── -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,22,0"
            Background="{StaticResource SurfaceRaised}" VerticalAlignment="Top"
            SnapsToDevicePixels="True">
      <StackPanel>

        <!-- 요일 헤더 -->
        <Border Background="{StaticResource SurfaceSunken}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Weekdays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Text}" FontSize="12.5" FontWeight="SemiBold"
                             Padding="0,9" TextAlignment="Center" Text="{Binding}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- 본문: 시간 눈금 + 빈 격자 + 수업 블록 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <ItemsControl Grid.Column="0" ItemsSource="{Binding Hours}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="56" Padding="6,4"
                        BorderBrush="{StaticResource BorderGrid}" BorderThickness="0,0,0,1">
                  <TextBlock Style="{StaticResource Mono}" FontSize="10.5" TextAlignment="Right"
                             Foreground="{StaticResource TextMonoLabel}" Text="{Binding}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Column="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"/>

          <Grid Grid.Column="1">
            <!-- 빈 칸 -->
            <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" Rows="10"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="56" BorderBrush="{StaticResource BorderGrid}"
                          BorderThickness="0,0,1,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 수업 블록: Grid.Row / RowSpan / Column 을 바인딩해 얹는다 -->
            <ItemsControl ItemsSource="{Binding Blocks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="56"/><RowDefinition Height="56"/>
                      <RowDefinition Height="56"/><RowDefinition Height="56"/>
                      <RowDefinition Height="56"/><RowDefinition Height="56"/>
                      <RowDefinition Height="56"/><RowDefinition Height="56"/>
                      <RowDefinition Height="56"/><RowDefinition Height="56"/>
                    </Grid.RowDefinitions>
                  </Grid>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Grid.Row" Value="{Binding Row}"/>
                  <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                  <Setter Property="Grid.Column" Value="{Binding Column}"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="2" Margin="2" Padding="8,6" ClipToBounds="True"
                          Background="{Binding Fill}"
                          BorderBrush="{Binding Bar}" BorderThickness="3,0,0,0">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Text}" FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextStrongAlt2}" Text="{Binding Name}"/>
                      <TextBlock Style="{StaticResource Mono}" FontSize="10.5" Margin="0,3,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource TextOnAccentMono}" Text="{Binding Room}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ── 우측 300px ────────────────────────────────────────────────── -->
    <StackPanel Grid.Column="1">

      <!-- 업로드 드롭존 -->
      <Grid x:Name="DropZone" AllowDrop="True"
            DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
            Background="Transparent" Cursor="Hand">
        <Rectangle x:Name="DropOutline" RadiusX="2" RadiusY="2" Fill="Transparent"
                   Stroke="{StaticResource BorderDashed}" StrokeThickness="1"
                   StrokeDashArray="3 2"/>
        <StackPanel Margin="16,20">
          <TextBlock Style="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold"
                     TextAlignment="Center" Text="{Binding DropZoneTitle}"/>
          <TextBlock Style="{StaticResource Text}" FontSize="11.5" Margin="0,6,0,0"
                     TextAlignment="Center" LineHeight="18.4"
                     LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextMonoLabel}" Text="{Binding DropZoneBody}"/>
          <TextBlock Style="{StaticResource Text}" FontSize="11.5" Margin="0,8,0,0"
                     TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{StaticResource EligibleFg}" Text="{Binding ImportStatus}"
                     Visibility="{Binding ImportStatus, Converter={StaticResource NullToVis}}"/>
        </StackPanel>
      </Grid>

      <!-- 수동 추가 -->
      <Border Style="{StaticResource Card}" Padding="15,14" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,10" Text="수동 추가"/>

          <Grid>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="12,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{StaticResource TextMonoLabel}" Text="과목명"
                       Visibility="{Binding Text.Length, ElementName=NameBox, Converter={StaticResource ZeroToVis}}"/>
          </Grid>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,4,0">
              <TextBox x:Name="DayBox" Style="{StaticResource Field}"
                       Text="{Binding NewDay, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="12,0,0,0"
                         VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{StaticResource TextMonoLabel}" Text="요일"
                         Visibility="{Binding Text.Length, ElementName=DayBox, Converter={StaticResource ZeroToVis}}"/>
            </Grid>

            <Grid Grid.Column="1" Margin="4,0,0,0">
              <TextBox x:Name="PeriodBox" Style="{StaticResource Field}"
                       Text="{Binding NewPeriod, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="12,0,0,0"
                         VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{StaticResource TextMonoLabel}" Text="교시 (예: 10-12)"
                         Visibility="{Binding Text.Length, ElementName=PeriodBox, Converter={StaticResource ZeroToVis}}"/>
            </Grid>
          </Grid>

          <Button Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Padding="10"
                  FontSize="12.5" Content="추가" Command="{Binding AddClassCommand}"/>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Text}" FontSize="12" Margin="2,14,2,0"
                 LineHeight="20.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                 Foreground="{StaticResource TextMuted2}" Text="{Binding Disclaimer}"/>
    </StackPanel>
  </Grid>
</UserControl>
