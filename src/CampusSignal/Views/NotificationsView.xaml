<UserControl x:Class="CampusSignal.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">

  <Grid Margin="26,20,26,34">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <!-- ── 알림 리스트 ───────────────────────────────────────────────── -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,24,0"
            VerticalAlignment="Top" SnapsToDevicePixels="True">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 미읽음 행은 배경이 살짝 다르다 -->
            <Button Style="{StaticResource RowButton}" Padding="18,15"
                    Background="{Binding RowBackground}" Command="{Binding Command}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding Dot}"/>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Badge}" Background="{Binding KindBackground}">
                      <TextBlock Style="{StaticResource Text}" FontSize="11"
                                 Foreground="{Binding KindForeground}" Text="{Binding KindText}"/>
                    </Border>
                    <TextBlock Style="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,5,0,0"
                             LineHeight="19.4" LineStackingStrategy="BlockLineHeight"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource TextMuted}" Text="{Binding Body}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="11.5"
                           TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMonoLabel}" Text="{Binding TimeText}"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ── 우측 330px ────────────────────────────────────────────────── -->
    <StackPanel Grid.Column="1">

      <Button Style="{StaticResource PrimaryButton}" FontSize="13"
              Content="{Binding PreviewButtonText}" Command="{Binding PreviewToastCommand}"/>

      <Border Style="{StaticResource Card}" Padding="16,15" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,10"
                     Text="{Binding SettingsTitle}"/>
          <ItemsControl ItemsSource="{Binding Settings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderGrid}" BorderThickness="0,0,0,1"
                        Padding="0,9">
                  <Grid>
                    <TextBlock Style="{StaticResource Text}" FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBody}" Text="{Binding Label}"/>
                    <Button Style="{StaticResource SettingToggle}" HorizontalAlignment="Right"
                            Command="{Binding Command}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
