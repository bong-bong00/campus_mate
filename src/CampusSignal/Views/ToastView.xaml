<UserControl x:Class="CampusSignal.Views.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Margin="0,0,20,20" Width="376">

  <UserControl.Resources>
    <!-- 등장 220ms ease-out — 앱에서 유일한 애니메이션이다. -->
    <Storyboard x:Key="ToastIn">
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
      <DoubleAnimation
          Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
          From="18" To="0" Duration="0:0:0.22">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <Style x:Key="ToastSecondary" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderBrush" Value="{StaticResource ToastBtnBd}"/>
      <Setter Property="Foreground" Value="{StaticResource NavIdleFg}"/>
    </Style>
  </UserControl.Resources>

  <Border CornerRadius="6" Padding="16,15"
          Background="{StaticResource ToastBg}"
          BorderBrush="{StaticResource ToastBd}" BorderThickness="1">
    <Border.RenderTransform>
      <TranslateTransform/>
    </Border.RenderTransform>
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
            <DataTrigger.EnterActions>
              <BeginStoryboard Storyboard="{StaticResource ToastIn}"/>
            </DataTrigger.EnterActions>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="14" Direction="270" Opacity="0.4" Color="#000000"/>
    </Border.Effect>

    <StackPanel>
      <Grid>
        <TextBlock Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{StaticResource BrandMark}"
                   inf:Tracking.Em="0.1" inf:Tracking.Text="CAMPUS SIGNAL"/>
        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                FontSize="12" Foreground="{StaticResource BrandMark}"
                Content="✕" Command="{Binding HideToastCommand}"/>
      </Grid>

      <TextBlock Style="{StaticResource Text}" FontSize="14.5" FontWeight="Bold"
                 Margin="0,10,0,0" LineHeight="21" LineStackingStrategy="BlockLineHeight"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource ToastFg}" Text="{Binding Toast.Title}"/>

      <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,7,0,0"
                 LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                 Foreground="{StaticResource TextOnDarkMuted2}" Text="{Binding Toast.Body}"/>

      <Grid Margin="0,13,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                FontSize="12.5" Padding="8"
                Background="{StaticResource Lime}" Foreground="{StaticResource Ink}"
                Content="{Binding Toast.PrimaryText}" Command="{Binding ToastPrimaryCommand}"/>
        <Button Grid.Column="1" Style="{StaticResource ToastSecondary}" Margin="8,0,0,0"
                Content="{Binding Toast.SecondaryText}" Command="{Binding HideToastCommand}"/>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
