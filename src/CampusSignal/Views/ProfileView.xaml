<UserControl x:Class="CampusSignal.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             Background="{StaticResource Surface}">

  <Grid Margin="26,20,26,34">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <!-- ── 좌측 ───────────────────────────────────────────────────────── -->
    <StackPanel Grid.Column="0" Margin="0,0,24,0">

      <!-- 성적표 업로드 배너 -->
      <Border CornerRadius="2" BorderThickness="1" Padding="18,16"
              Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderAccent}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock Style="{StaticResource Text}" FontSize="14.5" FontWeight="Bold"
                       TextWrapping="Wrap" Text="{Binding BannerTitle}"/>
            <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextOnAccent}" Text="{Binding BannerBody}"/>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                  FontSize="12.5" Padding="16,10"
                  Content="{Binding BannerButton}" Command="{Binding UploadTranscriptCommand}"/>
        </Grid>
      </Border>

      <!-- 필드 그룹 -->
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,22,0,0">
              <TextBlock Style="{StaticResource Text}" FontSize="14.5" FontWeight="Bold"
                         Text="{Binding Title}"/>
              <TextBlock Style="{StaticResource SectionNote}" Margin="0,4,0,0"
                         Text="{Binding Description}"/>

              <ItemsControl ItemsSource="{Binding Fields}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- 실제 구현에서는 이 카드가 곧 편집 가능한 입력 컨트롤이 된다. -->
                    <Border CornerRadius="2" BorderThickness="1" Padding="13,11" Margin="0,0,10,10"
                            Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                      <StackPanel>
                        <TextBlock Style="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource TextMonoLabel}" Text="{Binding Label}"/>
                        <TextBlock Style="{StaticResource Text}" FontSize="14" FontWeight="Medium"
                                   Margin="0,6,0,0"
                                   Foreground="{Binding Foreground}" Text="{Binding DisplayValue}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- ── 우측 330px ────────────────────────────────────────────────── -->
    <StackPanel Grid.Column="1">

      <Border CornerRadius="2" BorderThickness="1" Padding="16,15"
              Background="{StaticResource WarnSurface}" BorderBrush="{StaticResource BorderWarn}"
              Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text}" FontSize="13.5" FontWeight="Bold"
                     TextWrapping="Wrap" Text="{Binding BlockedTitle}"/>
          <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,8,0,0"
                     LineHeight="20.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextWarnBody}"
                     inf:Emphasis.Weight="Bold"
                     inf:Emphasis.Markup="{Binding BlockedBody}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="16,15" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="개인정보 저장 위치"/>
          <ItemsControl ItemsSource="{Binding PrivacyRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderGrid}" BorderThickness="0,0,0,1"
                        Padding="0,8">
                  <Grid>
                    <TextBlock Style="{StaticResource Text}" FontSize="12.5"
                               Foreground="{StaticResource TextBody2}" Text="{Binding Key}"/>
                    <TextBlock Style="{StaticResource Mono}" FontSize="12.5"
                               HorizontalAlignment="Right" Text="{Binding Value}"
                               Foreground="{Binding ToneKey, Converter={StaticResource ToneKeyToBrush}}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Text}" FontSize="11.5" Margin="0,10,0,0"
                     LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextMonoLabel}" Text="{Binding PrivacyCaption}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="16,15" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="수혜 이력"/>
          <ItemsControl ItemsSource="{Binding HistoryRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource BorderGrid}" BorderThickness="0,0,0,1"
                        Padding="0,8">
                  <Grid>
                    <TextBlock Style="{StaticResource Text}" FontSize="12.5"
                               Foreground="{StaticResource TextBody2}" Text="{Binding Key}"/>
                    <TextBlock Style="{StaticResource Mono}" FontSize="12.5"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextMuted2}" Text="{Binding Value}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
