<UserControl x:Class="CampusSignal.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
             Background="{StaticResource Surface}">

  <Grid Margin="26,20,26,34">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- ── 월간 격자 ─────────────────────────────────────────────────── -->
    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,22,0"
            VerticalAlignment="Top" SnapsToDevicePixels="True">
      <StackPanel>

        <Border Background="{StaticResource SurfaceSunken}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
          <ItemsControl ItemsSource="{Binding DayHeaders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Mono}" FontSize="11" Padding="0,9"
                           TextAlignment="Center"
                           Foreground="{StaticResource TextMonoLabel}" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 첫 칸 오프셋은 그 달 1일의 요일로 계산해 뷰모델이 이미 채워 보낸다. -->
        <ItemsControl ItemsSource="{Binding Cells}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Height="112" Padding="8,7" Background="{Binding Background}"
                      BorderBrush="{StaticResource BorderRow}" BorderThickness="0,0,1,1"
                      ClipToBounds="True">
                <StackPanel>
                  <TextBlock Style="{StaticResource Mono}" FontSize="11.5"
                             Foreground="{Binding NumberBrush}" Text="{Binding Number}"/>
                  <ItemsControl ItemsSource="{Binding Events}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="2" Padding="5,2" Margin="0,0,0,3"
                                Background="{Binding Background}">
                          <TextBlock Style="{StaticResource Text}" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{Binding Foreground}" Text="{Binding Label}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ── 우측 300px ────────────────────────────────────────────────── -->
    <StackPanel Grid.Column="1">

      <Border Style="{StaticResource Card}" Padding="15,14">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,10" Text="표시 항목"/>
          <ItemsControl ItemsSource="{Binding Legend}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                  <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2"
                             VerticalAlignment="Center" Fill="{Binding Color}"/>
                  <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="9,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextBody}" Text="{Binding Label}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DarkCard}" Padding="16" Margin="0,14,0,0"
              Visibility="{Binding HasOverlap, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Mono}" FontSize="10.5"
                     Foreground="{StaticResource Lime}"
                     inf:Tracking.Em="0.14" inf:Tracking.Text="OVERLAP"/>
          <TextBlock Style="{StaticResource Text}" FontSize="14.5" FontWeight="Bold"
                     Margin="0,9,0,0" LineHeight="21.8"
                     LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextOnDark2}" Text="{Binding OverlapTitle}"/>
          <TextBlock Style="{StaticResource Text}" FontSize="12.5" Margin="0,8,0,0"
                     LineHeight="20.6" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Foreground="{StaticResource TextOnDarkMuted2}" Text="{Binding OverlapBody}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
