<Window x:Class="CampusSignal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:CampusSignal.Infrastructure"
        xmlns:v="clr-namespace:CampusSignal.Views"
        Title="Campus Signal"
        Width="1440" Height="900" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── 상단 고정 헤더 (다크) ─────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{StaticResource Ink}">
      <StackPanel>

        <!-- 타이틀바 32px -->
        <Grid Height="32">
          <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Margin="26,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource BrandMark}"
                     inf:Tracking.Em="0.18"
                     inf:Tracking.Text="{Binding BrandMark}"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}"
                    Content="{StaticResource GlyphMinimize}"
                    ToolTip="최소화" Click="OnMinimize"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                    Content="{StaticResource GlyphMaximize}"
                    ToolTip="최대화" Click="OnMaximizeRestore"/>
            <Button Style="{StaticResource CaptionCloseButton}"
                    Content="{StaticResource GlyphClose}"
                    ToolTip="닫기" Click="OnClose"/>
          </StackPanel>
        </Grid>

        <!-- 헤더 본문 -->
        <Grid Margin="26,14,26,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding PageTitle}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding PageSubtitle}"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <ItemsControl Grid.Column="1" ItemsSource="{Binding NavItems}"
                        VerticalAlignment="Bottom" Margin="24,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NavButton}"
                        Content="{Binding Label}"
                        Command="{Binding Command}"
                        CommandParameter="{Binding Screen}"
                        Margin="8,0,0,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ── 콘텐츠 영역 ───────────────────────────────────────────────── -->
    <Grid Grid.Row="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Background="{StaticResource Surface}">
        <ContentControl Content="{Binding Current}"/>
      </ScrollViewer>

      <!-- 인앱 토스트 -->
      <v:ToastView DataContext="{Binding}"
                   Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"/>
    </Grid>
  </Grid>
</Window>
